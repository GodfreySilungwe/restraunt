# AWS Environment Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
DYNAMODB_TABLE_NAME=RestrauntTable

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# CORS Configuration
CORS_ORIGINS=https://your-cloudfront-distribution.cloudfront.net

# Admin Secret
ADMIN_SECRET=change-this-in-production

# S3 Configuration
S3_BUCKET_NAME=your-bucket-name

# Stripe Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLIC_KEY=your-stripe-public-key

# Airtel Configuration
AIRTEL_API_URL=https://api.sandbox.airtel.cm/
AIRTEL_MERCHANT_ID=your-merchant-id
AIRTEL_API_KEY=your-api-key
